.workbuddy/
# Linux 内核为 GPL-2.0，不得合入本项目（Apache-2.0）
linux-image/
firmware/
node_modules/
dist/
*.log
tmp/
.DS_Store
*.tsbuildinfo
.vscode/

# 9p 共享目录：保留 host.txt 作为验证素材，guest 写入物不入库
share/from-guest.txt

# shell 重定向笔误（\dev\null 少了前导 /）会在仓库根生成 dev/null，忽略防碍眼。
# 必须根锚定成 /dev/ —— 写成 `dev/` 会连 src/dev/ 一起忽略，
# 那样新增的设备源码根本提交不进去（2026-09-19 踩到）。
/dev/

# MCP SSH 会话锁：运行时产物（内容只有 pid / instanceId / 时间戳，随会话重写），不入库。
.mcp-ssh.lock
