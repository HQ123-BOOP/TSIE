{
  "name": "ts-riscv64",
  "version": "1.0.0",
  "description": "A RISC-V 64-bit (RV64GC) full-system emulator written in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "riscv64": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "tsx tools/bench.ts"
  },
  "keywords": [
    "riscv",
    "riscv64",
    "emulator",
    "rv64gc",
    "typescript",
    "sv39",
    "sv48"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
