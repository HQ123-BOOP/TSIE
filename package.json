{
  "name": "tsie",
  "version": "1.0.0",
  "description": "TSIE (TSIE Is an Emulator) - a RISC-V 64-bit (RV64GC) full-system emulator written in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tsie": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "tsx tools/bench.ts",
    "demo": "tsx examples/hello.ts",
    "uboot": "tsx src/cli.ts --bios firmware/opensbi-1.9-rv-bin/share/opensbi/lp64/generic/firmware/fw_jump.bin --kernel tmp/uboot/uboot.elf --disk tmp/disk.raw --script tmp/uboot-cmd.txt -n 60000000"
  },
  "keywords": [
    "riscv",
    "riscv64",
    "emulator",
    "rv64gc",
    "typescript",
    "sv39",
    "sv48",
    "tsie",
    "virtio",
    "9p"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
